<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="ai_product_recommanded" name="AI Product Recommandation" inherit_id="website_sale.product">
        <xpath expr="//div[@id='oe_structure_website_sale_product_2']" position="after">
            <section class="product_recommanded_ai as-ai-product-recommanded" t-att-data-product-tmpl-id="product.id">
                <div class="product_recommanded_container"></div>
            </section>
        </xpath>
    </template>

    <template id="ai_shop_product_recommanded" name="AI Shop Product Recommandation" inherit_id="website_sale.products" priority="99999">
        <xpath expr="//div[hasclass('products_header')]" position="inside">
            <div t-if="is_shop_rmp_active and not request.env.user._is_public()" class="as_rcp_header">
                <a href="#" role="button" data-bs-toggle="offcanvas" data-bs-target="#o_wsale_offcanvas_recommanded_product" title="Recommanded Product">
                    <div class="ai-ef">
                        <div class="ai-ef-02"/>
                        <div class="ai-ef-03"/>
                        <div class="ai-ef-in"></div>
                    </div>
                </a>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_products_main_row')]" position="after">
            <div t-if="is_shop_rmp_active and not request.env.user._is_public()">
                <t t-call="theme_alan.o_wsale_offcanvas_recommanded_product"/>
            </div>
        </xpath>
    </template>

    <template id="o_wsale_offcanvas_recommanded_product" name="Product Recommandation Offcanvans">
        <aside id="o_wsale_offcanvas_recommanded_product" class="o_website_offcanvas offcanvas offcanvas-end as-similar-product-modal as_recommanded_model as-ai-product-recommanded">
            <div class="offcanvas-header">
                <h5>AI-Powered Recommends
                    <div class="ioh">
                        <i class="i1 ii"></i>
                        <i class="i2 ii"></i>
                        <i class="i3 ii"></i>
                    </div>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"/>
            </div>
            <div class="offcanvas_recommanded_product offcanvas-body">
            </div>
        </aside>
    </template>

    <template id="ai_recommanded_shop_tmpl" name="Recommanded Shop" >
        <t t-set="product_ids" t-value="product.sudo().fetch_ai_recommanded_product()"/>
        <div t-if="product_ids" class="as-similar-product-list">
            <t t-foreach="product_ids" t-as="product">
                <t t-set="combination_info" t-value="product._get_combination_info(combination, add_qty=1)"/>
                <div class="as-similar-product">
                    <div class="sim-pro-img">
                        <img t-att-src="website.image_url(product, 'image_512')" title="" alt="" />
                    </div>
                    <div class="sim-pro-body">
                        <div class="as-sp-product d-flex">
                            <h4><a class="stretched-link text-decoration-none text-reset" t-att-href="product.website_url"><t t-esc="product.name"/></a></h4>
                            <div class="as-sp-ratings"><t t-call="theme_alan.as_rating_template"/></div>
                        </div>
                        <div class="as-sp-desc"><t t-esc="product.description_sale"/></div>
                        <div class="as-brand-sku d-flex mb-1">
                            <div class="as-sp-brand">
                                <t t-call="theme_alan.product_brand"/>
                            </div>
                            <div t-if="product.default_code" class="as-sp-sku"><b>SKU: </b><t t-esc="product.default_code"/></div>
                        </div>
                        <div t-if="product.product_variant_ids" itemprop="offers" itemscope="itemscope" itemtype="http://schema.org/Offer" class="product_price">
                            <span t-if="combination_info['price']" t-esc="combination_info['price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                            <del t-attf-class="text-danger mr-2 {{'' if combination_info['has_discounted_price'] else 'd-none'}}" style="white-space: nowrap;" t-esc="combination_info['list_price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}" />
                            <span itemprop="price" style="display:none;" t-esc="combination_info['price']" />
                            <span itemprop="priceCurrency" style="display:none;" t-esc="website.currency_id.name" />

                        </div>
                        <div class="as-sp-stock_info">
                            <t t-call="theme_alan.as_out_of_stock"/>
                        </div>
                    </div>
                </div>
            </t>
        </div>
        <div t-else="">
            <div class="alert alert-info">
                <p>We couldn't find any AI-Powered Recommends at the moment. Please explore products and add them to your cart, wishlist, or confirm your order.</p>
            </div>
        </div>
    </template>

    <template id="ai_recommanded_product_tmpl" name="Recommanded Product" >
        <t t-set="product_ids" t-value="product.sudo().fetch_ai_recommanded_product()"/>
        <div t-if="product_ids" class="as-product-recommanded-ai mb-5 mt-2 as-product-alt-acc-products">
            <div class="container">
                <div class="as-alternative-product as-pd-extra-slider">
                    <div class="as-pd-title">
                        <h3 class="as-ai-title">AI-Powered Recommends
                            <div class="ioh">
                                <i class="i1 ii"></i>
                                <i class="i2 ii"></i>
                                <i class="i3 ii"></i>
                            </div>
                        </h3>
                        <div class="end">
                            <div class="swiper-button-alt-prev as-alt-cc-prev"><i class="asi asi-chevron-left"/></div>
                            <div class="swiper-button-alt-next as-alt-cc-next"><i class="asi asi-chevron-right"/></div>
                        </div>
                    </div>
                    <div class="swiper as-al-alt-swiper as-ai-recommanded-swiper " id="as_alternative">
                        <div class="swiper-wrapper">
                            <t t-foreach="product_ids" t-as="ai_product">
                                <div class="swiper-slide">
                                    <div class="o_wsale_product_grid_wrapper as_color_variant as-product-card as-product-card-01">
                                        <div class="as-product-card-media as-media-ratio">
                                            <t t-set="as_combination_info" t-value="ai_product._get_combination_info()"/>
                                            <a t-att-href="ai_product.website_url">
                                                <div class="oe_product_image_img_wrapper as-media-ratio-wrap" t-field="ai_product.image_512" t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'o_alternative_product' }">
                                                </div>
                                            </a>
                                            <!--Hover Image-->
                                            <div t-if="ai_product.hover_image and website.active_shop_hover_image" class="as-hover-image">
                                                <span t-field="ai_product.hover_image" t-options="{'widget': 'image'}"/>
                                            </div>
                                            <!--lable-->
                                            <t t-if="website.active_product_label" t-call="theme_alan.product_label">
                                                <t t-set="product" t-value="ai_product"/>
                                            </t>
                                            <!-- Rating -->
                                            <t t-call="theme_alan.as_rating_template">
                                                <t t-set="product" t-value="ai_product"/>
                                            </t>
                                        </div>
                                        <div class="as-product-card-body">
                                            <!--Brand-->
                                            <div class="as-product-brand">
                                                <t t-call="theme_alan.product_brand">
                                                    <t t-set="product" t-value="ai_product"/>
                                                </t>
                                            </div>
                                            <!-- Product Name-->
                                            <div class="as-pc-title">
                                                <a t-att-href="ai_product.website_url">
                                                    <span t-att-title="ai_product.name" t-field="ai_product.name" style="display: block;" />
                                                </a>
                                            </div>
                                            <!-- Product Price -->
                                            <div t-if="not(request.env.user._is_public() and website.active_b2b_mode)" class="alt_price as-price as-pc-price ">
                                                <span class="aoe_price" style="white-space: nowrap;" t-esc="as_combination_info['price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                                <span t-attf-class="text-danger soe_default_price ms-1 h5 {{'' if as_combination_info['has_discounted_price'] else 'd-none'}}" style="text-decoration: line-through; white-space: nowrap;"
                                                    t-esc="as_combination_info['list_price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                                <t t-if="is_view_active('website_sale.tax_indication')" t-call="website_sale.tax_indication"/>
                                                <del t-if="ai_product.compare_list_price">
                                                    <span t-esc="ai_product.compare_list_price"
                                                        groups="website_sale.group_product_price_comparison"
                                                        t-options='{
                                                        "widget": "monetary",
                                                        "display_currency": ai_product.currency_id,
                                                    }'/>
                                                </del>
                                            </div>
                                            <div class="as-pd-b2b-login-btn as-p-b2b-btns" t-if="request.env.user._is_public() and website.active_b2b_mode">
                                                <a href="/web/login" t-attf-class="btn btn-primary #{'as_login_popup' if website.active_login_popup else ''}"><i class="asi asi-lock"></i> <span> Login for Price </span></a>
                                            </div>
                                            <!-- SKU -->
                                            <div class="as-product-card-sku" t-if="website.active_shop_product_reference and ai_product.product_variant_id.default_code">
                                                <b>SKU:</b><span t-esc="ai_product.product_variant_id.default_code" />
                                            </div>
                                            <!-- Offer Timer -->
                                            <div class="as-product-offer-time">
                                                <t t-call="theme_alan.as_offer_timer">
                                                    <t t-set="product" t-value="ai_product"/>
                                                </t>
                                            </div>
                                            <!-- Color Variant  -->
                                            <div class="as-pc-colors" t-if="ai_product.have_color_attribute and website.active_shop_color_variant">
                                                <ul>
                                                    <t t-foreach="ai_product.get_variant_color_images()" t-as="vc">
                                                        <li>
                                                            <label t-att-data-product_tmpl_id="ai_product.id"  class="as_color_variant_img css_attribute_color_tag p-3" t-attf-style="background-image: url({{vc}}); background-size: cover;">
                                                                <span t-att-data-color-image="vc" />
                                                            </label>
                                                        </li>
                                                    </t>
                                                </ul>
                                            </div>
                                            <!-- Out Of Stock -->
                                            <t t-call="theme_alan.as_out_of_stock">
                                                <t t-set="product" t-value="ai_product"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

</odoo>
