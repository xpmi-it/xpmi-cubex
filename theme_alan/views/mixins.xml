    <!-- User Dashboard Popup: END -->

    <!-- WishList Page-->
    <template id="custom_product_wishlist" inherit_id="website_sale_wishlist.product_wishlist" name="Theme Alan Custom Wishlist Page">
        <xpath expr="." position="replace">
            <t t-call="website.layout">
                <t t-set="additional_title">Shop Wishlist</t>
                <div id="wrap" class="js_sale">
                    <div class="oe_structure" id="oe_structure_website_sale_wishlist_product_wishlist_1"/>
                    <div class="container oe_website_sale pt-3">
                        <section class="container wishlist-section">
                            <div class="as_wishlist_title row align-items-center">
                                <div class="col-12 mb-2">
                                    <t t-set="wishcount" t-value="len(request.env['product.wishlist'].current())"/>
                                    <h3 class="d-inline-block mb-0 me-2">My Wishlist</h3>
                                    <span class="as_wishlist_count"><t t-esc="wishcount"/></span> items
                                </div>
                                <hr/>
                            </div>
                            <div t-if="not (request.env.user._is_public() and website.active_b2b_mode)" class="checkbox mb-2">
                                <label class='text-muted'><input type="checkbox" id='b2b_wish' value="1" class="mr8"/>Add product to my cart but keep it in my wishlist</label>
                            </div>

                            <table class="table table-bordered table-striped table-hover text-center mt16 table-comparator " style="table-layout:auto" id="o_comparelist_table">
                                <body>
                                    <div class="row">
                                        <t t-foreach="wishes" t-as="wish">
                                            <t t-set="combination_info" t-value="wish.product_id._get_combination_info_variant()"/>
                                            <div class="as_wish_product col-lg-3 d-flex" t-att-data-wish-id="wish.id" t-att-data-product-id="wish.product_id.id" t-att-data-product-tracking-info="'product_tracking_info' in combination_info and json.dumps(combination_info['product_tracking_info'])">
                                                <div class="as_wish_product_card card">
                                                    <a t-att-href="wish.product_id.website_url">
                                                        <img t-attf-src="/web/image/product.product/#{wish.product_id.id}/image_1920" class="card-img-top" style="margin:auto;" alt="Product image"/>
                                                    </a>
                                                    <a href="#" class="shadow rounded-circle text-muted o_wish_rm position-absolute top-0 end-0 m-2" title="Remove Product from wishlist">
                                                        <i class="fa fa-times"></i>
                                                    </a>
                                                    <t t-call="theme_alan.product_label">
                                                        <t t-set="product" t-value="wish.product_id"/>
                                                    </t>
                                                    <div class="card-body">
                                                        <strong><a t-att-href="wish.product_id.website_url"><t t-esc="wish.product_id.display_name" /></a></strong>
                                                        <small class='d-none d-md-block'><p t-field="wish.product_id.description_sale" class="text-muted pro_desc"/></small>
                                                        <div t-if="not (request.env.user._is_public() and website.active_b2b_mode)" class="as_wish_price">
                                                            <span class="oe_price" style="white-space: nowrap;" t-esc="combination_info['price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                                            <span t-attf-class="text-danger oe_default_price ms-1 {{'' if combination_info['has_discounted_price'] else 'd-none'}}" style="text-decoration: line-through !important; white-space: nowrap;"
                                                            t-esc="combination_info['list_price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                                        </div>
                                                        <input name="product_id" t-att-value="wish.product_id.id" type="hidden"/>
                                                        <a t-if="combination_info['prevent_zero_price_sale']" t-att-href="website.contact_us_button_url" class="btn btn-primary btn_cta">Contact Us</a>
                                                        <div class="as_wish_btn">
                                                            <div class="as_wish_cart">
                                                                <button t-if="not (request.env.user._is_public() and website.active_b2b_mode)" id="add_to_cart_button" type="button" role="button" class="btn btn-secondary btn-block o_wish_add" >
                                                                <i t-attf-class="fa fa-shopping-cart"></i>
                                                                <span class='d-none d-md-inline'>Add to Cart</span>
                                                                </button>
                                                                <button t-else=" " href="/web/login" t-attf-class="#{'as_login_popup' if website.active_login_popup else ''} btn btn-secondary btn-block" type="button" role="button">
                                                                Login for price
                                                                </button>
                                                            </div>
                                                            <div class="as_add_to_compare">
                                                                <t t-set="categories" t-value="wish.product_id.product_tmpl_id.valid_product_template_attribute_line_ids._prepare_categories_for_display()"/>
                                                                <t t-set="product_variant_id" t-value="wish.product_id.product_tmpl_id._get_first_possible_variant_id()"/>
                                                                <button t-if="is_view_active('website_sale_comparison.add_to_compare') and product_variant_id and categories" type="button" class="btn btn-primary o_add_to_compare no-decoration" t-att-data-product-id='wish.product_id.id'>
                                                                        <small><i t-attf-class="fa fa-exchange"></i>
                                                                        <span class='d-none d-md-inline'>Add to compare</span>
                                                                    </small>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                     </div>
                                </body>
                            </table>
                        </section>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

</odoo>