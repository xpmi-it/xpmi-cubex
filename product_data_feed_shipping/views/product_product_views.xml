<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form.inherit.product_data_feed_shipping</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='feed_shipping_ids']" position="before">
                <field name="feed_shipping_group_id" context="{'default_type': 'shipping_group'}"/>
            </xpath>
            <xpath expr="//field[@name='feed_ships_from_country_id']" position="after">
                <label for="feed_shipping_weight"/>
                <div class="o_row">
                    <field name="feed_shipping_weight"/>
                    <field name="feed_shipping_weight_uom" widget="selection" required="feed_shipping_weight != 0"/>
                </div>
                <label for="feed_shipping_length" string="Shipping Sizes"/>
                <div class="o_row">
                    <field name="feed_shipping_length"/>
                    <span class="text-muted"> x </span>
                    <field name="feed_shipping_width"/>
                    <span class="text-muted"> x </span>
                    <field name="feed_shipping_height"/>
                    <field name="feed_shipping_size_uom" widget="selection" required="feed_shipping_length != 0 and feed_shipping_width != 0 and feed_shipping_height != 0"/>
                </div>
                <field name="feed_shipping_transit_time_group_id" context="{'default_type': 'transit_time'}"/>
                <label for="feed_shipping_min_handling_time" string="Handling Time"/>
                <div class="o_row">
                    <field name="feed_shipping_min_handling_time"/>
                    <span class="text-muted"> - </span>
                    <field name="feed_shipping_max_handling_time"/>
                    <span class="text-muted"> days</span>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
