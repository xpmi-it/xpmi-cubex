<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="customerinfo_line_it_FatturaPA"
        inherit_id="l10n_it_edi.account_invoice_line_it_FatturaPA"
    >
        <xpath expr="//DettaglioLinee/Descrizione" position="before">
            <CodiceArticolo t-if="line.product_customer_code">
                <CodiceTipo
                    t-esc="env['ir.config_parameter'].sudo().get_param('fatturapa.codicetipo.customerinfo', 'ODOO')"
                />
                <CodiceValore
                    t-out="format_alphanumeric(line.product_customer_code, 35)"
                />
            </CodiceArticolo>
        </xpath>
    </template>
</odoo>
