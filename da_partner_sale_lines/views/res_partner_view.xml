<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_partner_sale_line_list" model="ir.actions.act_window">
        <field name="name">Sale Order Lines</field>
        <field name="res_model">sale.order.line</field>
        <field name="context">{}</field>
        <field
            name="domain"
        >[('state', 'in', ['sale', 'done']), ('order_partner_id', 'in', active_ids)]</field>
    </record>

    <record id="res_partner_sales_form_view" model="ir.ui.view">
        <field name="name">res.partner.sales.form.view</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="sale.res_partner_view_buttons" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    name="%(da_partner_sale_lines.action_partner_sale_line_list)d"
                    type="action"
                    icon="fa-usd"
                    groups="sales_team.group_sale_salesman"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Sale Lines</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
