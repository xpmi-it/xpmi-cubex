            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="code">model._update_ship_tracking_brt_cron()</field>
        </record>

        <record id="ir_cron_update_missing_tracking_ref_brt" model="ir.cron">
            <field name="name">Update Missing Tracking Ref BRT</field>
            <field name="user_id" ref="base.user_root"/>
