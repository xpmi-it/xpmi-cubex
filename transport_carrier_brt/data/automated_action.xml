<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="ir_cron_update_tracking_brt" model="ir.cron">
            <field name="name">Update Tracking Shipping BRT</field>
            <field name="user_id" ref="base.user_root"/>
