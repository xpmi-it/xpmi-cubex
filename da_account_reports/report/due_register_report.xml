<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="due_register_template">
        <t t-call="web.basic_layout">
            <div class="page" style="font-size:10px;">
                <table class="table table-borderless table-sm">
                    <thead style="border-bottom: solid 1px;">
                        <tr>
                            <th>Due Date</th>
                            <th>Numero Riconciliazione</th>
                            <th>Invoice Date</th>
                            <th>Invoice Number</th>
                            <th>Document</th>
                            <th>Accounting Date</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <t t-foreach="suppliers.values()" t-as="supplier">
                        <tr style="border-top: solid 1px; font-size: 12px;">
                            <td>
                                <strong>Supplier</strong>
                            </td>
                            <td t-esc="supplier['partner'].ref" />
                            <td t-esc="supplier['partner'].name" />
                            <td colspan="5" />
                        </tr>
                        <tbody>
                            <t t-foreach="supplier['lines']" t-as="line">
                                <tr class="m-0">
                                    <td><t t-esc="line.date_maturity.strftime('%d/%m/%Y')"/></td>
                                    <td><t t-esc="line.matching_number"/></td>
                                    <td><t t-esc="line.invoice_date.strftime('%d/%m/%Y')"/></td>
                                    <td><t t-esc="line.ref"/></td>
                                    <td><t t-esc="line.move_name"/></td>
                                    <td><t t-esc="line.move_id.date.strftime('%d/%m/%Y')"/></td>
                                    <td class="text-end">
                                        <t
                                            t-esc="line.move_type == 'in_refund'
                                                   and -abs(line.amount_residual)
                                                   or abs(line.amount_residual)"
                                            t-options='{"widget": "monetary", "display_currency": line.company_currency_id}'
                                        />
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="4"/>
                                <td class="text-start" style="border-top: solid 1px;">
                                    <strong>Amount Supplier</strong>
                                </td>
                                <td class="text-center" style="border-top: solid 1px;">
                                   <strong>Payment Amount</strong>
                                </td>
                                <td class="text-end" style="border-top: solid 1px">
                                    <strong>
                                        <t
                                            t-esc="supplier['gross']"
                                            t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'
                                        />
                                    </strong>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="5"/>
                                <td class="text-center">
                                    <strong>Refund</strong>
                                </td>
                                <td class="text-end">
                                    <strong>
                                        <t
                                            t-esc="supplier['refund']"
                                            t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'
                                        />
                                    </strong>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="5"/>
                                <td class="text-center">
                                    <strong>Net Amount</strong>
                                </td>
                                <td class="text-end">
                                    <strong>
                                        <t
                                            t-esc="supplier['net']"
                                            t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'
                                        />
                                    </strong>
                                </td>
                            </tr>
                        </tbody>
                    </t>
                </table>
            </div>
        </t>
    </template>


    <template id="due_register_report_a4">
        <t t-call="web.html_container">
            <div class="header">
                <div class="row" style="font-size: 12px;">
                    <div class="col-4 text-start">
                        <t t-esc="env.company.name"/>
                    </div>
                    <div class="col-4 text-center">
                        <p>Supplier due register</p>
                    </div>
                    <div class="col-4 text-end">
                        <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </div>
             <t t-call="da_account_reports.due_register_template"/>
        </t>
    </template>

    <record id="action_due_register_report" model="ir.actions.report">
        <field name="name">Due Register Report A4</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">da_account_reports.due_register_report_a4</field>
        <field name="report_file">da_account_reports.due_register_report_a4</field>
        <field name="print_report_name" >'Due Register Report'</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="da_account_reports.da_account_reports_paperformat" />
    </record>
</odoo>
