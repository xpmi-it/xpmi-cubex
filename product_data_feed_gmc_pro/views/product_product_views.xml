<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form.inherit.product_data_feed_gmc_pro</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='gmc_identifiers']" position="inside">
                <field name="feed_gmc_identifier_exists"/>
            </xpath>
            <xpath expr="//group[@name='gmc_details']" position="inside">
               <field name="feed_gmc_multipack"/>
               <field name="feed_gmc_is_bundle"/>
               <label for="feed_gmc_min_energy_efficiency_class" string="EEI Range" help="Energy Efficiency Class Range."/>
               <div class="o_row">
                  <field name="feed_gmc_min_energy_efficiency_class" widget="selection"/>
                  <span class="text-muted" title="Separator"> - </span>
                  <field name="feed_gmc_max_energy_efficiency_class" widget="selection"/>
               </div>
               <field name="feed_gmc_age_group" string="Age Group"/>
               <field name="feed_gmc_for_adult"/>
            </xpath>            
            <xpath expr="//group[@name='gmc_shopping']" position="inside">
                <field name="feed_gmc_ads_redirect_url"/>
                <field name="feed_gmc_pause"/>
            </xpath>
        </field>
    </record>

    <record id="extra_product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form.inherit.product_data_feed_extra</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product_data_feed_extra.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='feed_size_system']" position="after">
                <field name="feed_gmc_size_type_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

</odoo>
