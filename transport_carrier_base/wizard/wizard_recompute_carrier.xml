<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- wizard view -->
        <record id="recompute_carrier_wizard_view" model="ir.ui.view">
            <field name="name">Recompute Carrier Wizard</field>
            <field name="model">sale.order.recompute.carrier</field>
            <field name="arch" type="xml">
                <form name="Recompute Carrier">
                    <footer>
                        <button name="recompute_carrier" string="Recompute Carrier" type="object" class="oe_highlight"/>
                        or
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_recompute_carrier_wizard_action">
            <field name="name">Recompute Carrier</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">form</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.order.recompute.carrier</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="recompute_carrier_wizard_view"/>
            <field name="target">new</field>
            <field name="groups_id" eval="[(4, ref('group_transport_carrier_base'))]"/>
        </record>

    </data>

</odoo>
