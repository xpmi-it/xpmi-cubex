<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="transport_condition_form_view" model="ir.ui.view">
            <field name="name">transport.condition.form</field>
            <field name="model">transport.condition</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="transport_condition_tree_view" model="ir.ui.view">
            <field name="name">transport.condition.list</field>
            <field name="model">transport.condition</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="action_transport_condition" model="ir.actions.act_window">
            <field name="name">Transport Condition</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">transport.condition</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="transport_condition_menu" name="Transport Condition"
                  parent="transport_carrier_main_menu"
                  action="action_transport_condition"
                  sequence="10"/>

    </data>
</odoo>
