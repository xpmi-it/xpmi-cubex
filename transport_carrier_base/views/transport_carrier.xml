<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="transport_carrier_form_view" model="ir.ui.view">
            <field name="name">transport.carrier.form</field>
            <field name="model">transport.carrier</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name"/>
                        <field name="carrier"/>
                        <field name="sequence_id" required="context.get('show_children_fields', False)"
                               invisible="context.get('show_children_fields', False)"/>
                        <field name="default_package_type_id" invisible="context.get('show_children_fields', False)"/>
                        <field name="group_into_single_package" invisible="context.get('show_children_fields', False)"/>
                        <field name="picking_in_note" invisible="context.get('show_children_fields', False)"/>
                        <field name="max_parcel" invisible="context.get('show_children_fields', False)"/>
                        <field name="check_and_force_weight" invisible="context.get('show_children_fields', False)"/>
                        <field name="check_min_weight"
                               invisible="not check_and_force_weight or context.get('show_children_fields', False)"/>
                        <field name="check_max_weight"
                               invisible="context.get('show_children_fields', False) or not check_and_force_weight"/>
                        <field name="force_weight"
                               invisible="context.get('show_children_fields', False) or not check_and_force_weight"/>
                        <field name="max_circumference"
                               invisible="context.get('show_children_fields', False) or max_parcel != 1"/>
                        <field name="volume_conversion" invisible="context.get('show_children_fields', False)"/>
                    </group>
                    <group>
                        <field name="check_max_char_street" invisible="context.get('show_children_fields', False)"/>
                        <field name="option_check_street" invisible="context.get('show_children_fields', False)"/>
                        <field name="delivery_carrier_ids" widget="many2many_tags"
                               invisible="context.get('show_children_fields', False)"/>
                        <field name="team_ids" widget="many2many_tags"
                               invisible="context.get('show_children_fields', False)"/>
                        <field name="destination_type"
                               invisible="context.get('show_children_fields', False)"
                        />
                        <field name="delivery_type" widget="radio"
                               invisible="destination_type == 'multi'"/>
                        <field name="warehouse_id"/>
                        <label for="efficienty"/>
                        <div>
                            <field name="efficienty" class="oe_inline"
                                   invisible="context.get('show_children_fields', False)"/>
                        </div>
                    </group>
                    <group string="Info Divisor" invisible="context.get('show_children_fields', False)">
                        <field name="peso_campione"/>
                        <field name="divisor"/>
                        <field name="divisor2"/>
                    </group>
                    <group name="extra" string="Extra" invisible="context.get('show_children_fields', False)">
                        <field name="extra_percent"/>
                        <field name="extra_fix"/>
                    </group>
                    <notebook>
                        <page name="function_allowed" string="Function Allowed"
                              invisible="context.get('show_children_fields', False)">
                            <group>
                                <field name="deletion_shipping"/>
                                <field name="validation_shipping"/>
                                <field name="check_weight"/>
                                <field name="check_volume"/>
                            </group>
                        </page>
                        <page name="tracking_info" string="Tracking Info"
                              invisible="context.get('show_children_fields', False)">
                            <group>
                                <field name="start_link"/>
                                <field name="end_link"/>
                            </group>
                        </page>
                        <page name="connection_info" string="Connection Info"
                              invisible="context.get('show_children_fields', False)">
                            <group>
                                <field name="user"/>
                                <field name="passwd" password="True"/>
                            </group>
                        </page>
                        <page string="Pricing" invisible="destination_type == 'multi'">
                            <group invisible="delivery_type != 'fixed'">
                                <field name="fixed_price"/>
                            </group>
                            <group name="general" invisible="delivery_type != 'base_on_rule'">
                                <field name="price_rule_ids" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Destination" name="destination"
                              invisible="destination_type == 'multi'">
                            <group>
                                <p colspan="2">
                                    Filling this form allows you to filter delivery carriers according to the
                                    delivery address of your customer.
                                </p>
                            </group>
                            <group>
                                <group>
                                    <field name="country_ids" widget="many2many_tags"/>
                                    <field name="state_ids" widget="many2many_tags"
                                           domain="[('country_id', 'in', country_ids)]"
                                           readonly="not country_ids"/>
                                </group>
                                <group></group>
                                <group>
                                    <field name="zip_from"/>
                                </group>
                                <group>
                                    <field name="zip_to"/>
                                </group>
                            </group>
                        </page>
                        <page string="Destinations" name="page_multi_destination"
                              invisible="destination_type != 'multi'">
                            <field name="child_ids"
                                   context="{'show_children_fields': True}">
                                <list>
                                    <field name="name"/>
                                    <button name="copy" type="object" string="Duplica"/>
                                </list>
                            </field>
                        </page>
                        <page string="Product Extra" name="product_extra"
                              invisible="context.get('show_children_fields', False)">
                            <field name="extra_ids"
                                   context="{'show_children_fields': True}">
                                <list editable="top">
                                    <field name="transport_carrier_id" column_invisible="True"/>
                                    <field name="product_id"/>
                                    <field name="extra_cost"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <record id="transport_carrier_tree_view" model="ir.ui.view">
            <field name="name">transport.carrier.list</field>
            <field name="model">transport.carrier</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <menuitem id="transport_carrier_main_menu" name="Transport Carrier"
                  parent="stock.menu_stock_root" sequence="9"/>

        <record id="action_transport_carrier" model="ir.actions.act_window">
            <field name="name">Transport Carrier</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">transport.carrier</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('parent_id', '=', False)]</field>
            <field name="context">{'show_children_carriers': True}</field>
        </record>

        <menuitem id="transport_carrier_menu" name="Transport Carrier"
                  parent="transport_carrier_main_menu"
                  action="action_transport_carrier"
                  sequence="1"/>

    </data>
</odoo>
