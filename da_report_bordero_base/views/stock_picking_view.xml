<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="stock_picking_num_bordero_form_view" model="ir.ui.view">
            <field name="name">stock.picking.num.bordero.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <field name="picking_type_id" position="after">
                    <field name="num_bordero"/>
                </field>
            </field>
        </record>

        <record id="stock_picking_num_bordero_list_view" model="ir.ui.view">
            <field name="name">stock.picking.list.inherit.view</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="arch" type="xml">
                <field name="state" position="after">
                    <field name="num_bordero"/>
                </field>
            </field>
        </record>

</odoo>
