<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="picking_bordero_wizard_view" model="ir.ui.view">
        <field name="name">Picking Bordero Wizard</field>
        <field name="model">picking.bordero.wizard</field>
        <field name="arch" type="xml">
            <form>
                <footer>
                    <button name="print_bordero" string="Print Bordero"
                            type="object" class="oe_highlight m-2"/>
                    <button string="Cancel" class="oe_link" special="cancel" id="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="bordero_action_wizard">
        <field name="name">Print Bordero</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list,form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">picking.bordero.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="picking_bordero_wizard_view"/>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>


</odoo>