<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="external_layout_clean_inherit" inherit_id="web.external_layout_clean">
        <xpath expr="//div[hasclass('o_clean_header')]" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_clean_header')]" position="after">
            <div class="o_clean_header">
                <div class="row">
                    <div class="col-3 mb4">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 45px;" alt="Logo"/>
                    </div>
                    <div class="col-9 text-right" style="margin-top:22px;" t-field="company.report_header" name="moto"/>
                </div>
                <div t-if="company.logo or company.report_header" class="row zero_min_height">
                    <div class="col-12">
                        <div style="border-bottom: 1px solid black;"/>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6" name="company_address">
                        <div t-field="company.partner_id"
                            t-options='{"widget": "contact", "fields": ["address", "name", "vat"], "no_marker": true}'
                        />
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('row', 'mt8')]" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('row', 'mt8')]" position="after">
            <div class="text-center">
                <ul class="list-inline mb4">
                    <li t-if="company.phone" class="list-inline-item d-inline"><span class="o_force_ltr" t-field="company.phone"/></li>
                    <li t-if="company.email" class="list-inline-item d-inline"><span t-field="company.email"/></li>
                    <li t-if="company.website" class="list-inline-item d-inline"><span t-field="company.website"/></li>
                </ul>

                <div name="financial_infos">
                    <span t-field="company.report_footer"/>
                </div>

                <div t-if="report_type == 'pdf'" class="text-muted">
                    Page: <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
