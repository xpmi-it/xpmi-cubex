<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_company_form_followup_inherit_view" model="ir.ui.view">
        <field name="name">res.company.form.followup.inherit.view</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='color']" position="after">
                <field
                    name="overdue_invoice_report_message"
                    options="{'style-inline': true, 'codeview': true}"
                    groups="base.group_no_one"
                />
            </xpath>
        </field>
    </record>
</odoo>
