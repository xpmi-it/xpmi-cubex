<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_form_followup_inherit_view" model="ir.ui.view">
        <field name="name">res.partner.form.followup.inherit.view</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account_followup.res_partner_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='open_customer_statement']" position="before">
                <button
                    groups="account.group_account_invoice"
                    type="object"
                    class="oe_stat_button"
                    name="action_print_followup_letter"
                    icon="fa-file-pdf-o"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Print Follow-up Letter</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
