<odoo>
    <template id="overdue_inv_report_template">
        <t t-call="web.html_container" t-lang="partner.lang">
            <t t-call="web.external_layout" t-lang="partner.lang">
                <t
                    t-set="invoices"
                    t-value="invoices.with_context(lang=partner.lang)"
                />

                <div class="page">
                    <div name="partner_info" class="offset-6 col-6">
                        <div
                            t-out="partner"
                            t-options='{"widget": "contact", "fields": ["address", "name", "vat"], "no_marker": True}'
                        />
                    </div>

                    <p>Date: <span t-out="date_today" /></p>
                    <p>Partner Ref.: <span t-out="partner.ref" /></p>

                    <h1 class="m-5">Payment Reminder</h1>

                    <p class="mb-2">Dear <span t-out="partner.display_name" />,</p>
                    <div t-out="env.company.overdue_invoice_report_message" />

                    <table class="table table-bordered table-sm mt-4">
                        <thead>
                            <tr>
                                <th />
                                <th class="text-center">Date</th>
                                <th class="text-center">Due Date</th>
                                <th class="text-center">Origin</th>
                                <th class="text-end">Ref</th>
                                <th class="text-end">Amount Due</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t
                                t-set="overdue_invoices"
                                t-value="invoices.filtered(lambda i: i.invoice_date_due &lt; date_due)"
                            />
                            <t
                                t-set="due_invoices"
                                t-value="invoices.filtered(lambda i: i.invoice_date_due &gt;= date_due)"
                            />
                            <tr t-foreach="overdue_invoices" t-as="overdue_inv">
                                <td class="text-center" t-out="overdue_inv.name" />
                                <td
                                    class="text-center"
                                    t-out="overdue_inv.invoice_date"
                                    t-options="{'widget': 'date'}"
                                />
                                <td
                                    class="text-center text-danger"
                                    t-out="overdue_inv.invoice_date_due"
                                    t-options="{'widget': 'date'}"
                                />
                                <td
                                    class="text-center"
                                    t-out="overdue_inv.invoice_origin"
                                />
                                <td class="text-end" t-out="overdue_inv.ref" />
                                <td
                                    class="text-end"
                                    t-out="overdue_inv.amount_residual_signed"
                                    t-options='{"widget": "monetary", "display_currency": overdue_inv.company_currency_id}'
                                />
                            </tr>
                            <tr t-if="overdue_invoices">
                                <td
                                    colspan="5"
                                    class="text-end fw-bold"
                                >Total Overdue</td>
                                <td
                                    class="text-end fw-bold"
                                    t-out="sum(overdue_invoices.mapped('amount_residual_signed'))"
                                    t-options='{"widget": "monetary", "display_currency": overdue_invoices[0].company_currency_id if overdue_invoices else env.company.currency_id}'
                                />
                            </tr>
                            <tr t-foreach="due_invoices" t-as="due_inv">
                                <td class="text-center" t-out="due_inv.name" />
                                <td
                                    class="text-center"
                                    t-out="due_inv.invoice_date"
                                    t-options="{'widget': 'date'}"
                                />
                                <td
                                    class="text-center text-danger"
                                    t-out="due_inv.invoice_date_due"
                                    t-options="{'widget': 'date'}"
                                />
                                <td
                                    class="text-center"
                                    t-out="due_inv.invoice_origin"
                                />
                                <td class="text-end" t-out="due_inv.ref" />
                                <td
                                    class="text-end"
                                    t-out="due_inv.amount_residual_signed"
                                    t-options='{"widget": "monetary", "display_currency": due_inv.company_currency_id}'
                                />
                            </tr>
                            <tr t-if="due_invoices">
                                <td colspan="5" class="text-end fw-bold">Total Due</td>
                                <td
                                    class="text-end fw-bold"
                                    t-out="sum(due_invoices.mapped('amount_residual_signed'))"
                                    t-options='{"widget": "monetary", "display_currency": due_invoices[0].company_currency_id if due_invoices else env.company.currency_id}'
                                />
                            </tr>
                        </tbody>
                    </table>

                    <div class="row mt-2">
                        <div class="offset-8 col-2">
                            <p class="text-end fw-bold me-2">General Total</p>
                        </div>
                        <div class="col-2">
                            <p
                                class="text-end fw-bold"
                                t-out="sum(invoices.mapped('amount_residual_signed'))"
                                t-options='{"widget": "monetary", "display_currency": invoices[0].company_currency_id if invoices else env.company.currency_id}'
                            />
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
