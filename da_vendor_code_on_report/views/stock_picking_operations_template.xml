<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_picking_inherit" inherit_id="stock.report_picking">
        <xpath expr="//table/thead/tr/th[@name='th_product']" position="before">
            <th name="th_code">
                <strong>Vendor Code</strong>
            </th>
        </xpath>
        <xpath expr="//table/tbody/tr/td[1]" position="before">
            <td id="code">
                <span t-esc="ml.product_id._get_vendor_code()" />
            </td>
        </xpath>
    </template>
</odoo>
