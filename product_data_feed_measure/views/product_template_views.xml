<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form.inherit.product_data_feed_measure</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_po_id']" position="after">
                <label for="pricing_measure" groups="uom.group_uom"/>
                <div class="o_row" groups="uom.group_uom">
                    <field name="pricing_measure"/>
                    <field name="uom_name" readonly="1"/>
                    <span class="text-muted"> Base:</span>
                    <field name="pricing_base_measure"/>
                    <field name="uom_name" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
