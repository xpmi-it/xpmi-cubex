<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_product_sale_inherit_form_view" model="ir.ui.view">
        <field name="name">sale.order.product.sale.inherit.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/list/field[@name='product_id']"
                position="after"
            >
                <button name="show_product_sold" type="object" string="Sales" />
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_date_inherit_tree_view" model="ir.ui.view">
        <field name="name">sale.order.line.date.inherit.tree</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='order_id']" position="after">
                <field name="scheduled_date" />
            </xpath>
        </field>
    </record>
</odoo>
